# ---------------------------------------------------------------------------
# Never commit secrets. These are provisioned per machine:
#   secrets/cert.pem        Cloudflare account credential (contains apiToken)
#   secrets/<tunnel-id>.json Tunnel credential
#   API-KEY.txt             plaintext lanKey, auto-generated by sync-key.ps1
# ---------------------------------------------------------------------------
secrets/
API-KEY.txt

# Runtime state and logs (pid files, lock, request log, tunnel log)
logs/
run/
*.log

# Credentials and backups that must never be committed
*.pem
*.key
*.crt
*.bak
.env*

# Third-party binary, replaced per machine. See bin/README.md for the
# version and SHA-256 to verify.
bin/*.exe

# OS / editor noise
Thumbs.db
Desktop.ini
.DS_Store
*~
*.swp
